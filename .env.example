# TeamFlow frontend (optional) — copy to .env in the repository root if needed.
# Only variables prefixed with VITE_ are exposed to the browser bundle (never put secrets here).
#
# Default behavior (see src/lib/api/api-base-url.ts):
# - Vite dev → http://localhost:4000
# - Production/preview on Vercel → same-origin "" (vercel.json rewrites /api/* to Render)
# VITE_API_URL is an optional override for special setups. Leave it unset on Vercel
# so the browser talks to /api/... on the current domain (not onrender.com directly).

# Local override example:
# VITE_API_URL=http://localhost:4000

# Direct API origin override (no trailing slash; do not append /api):
# VITE_API_URL=https://api.example.com

# Socket.IO origin (non-secret). Required for production realtime chat when HTTP API
# is same-origin via Vercel rewrites — WebSockets cannot use those /api rewrites.
# Local Vite: leave unset (sockets use the API origin, usually http://localhost:4000).
# Vercel production/preview: set at build time to the Render backend origin, no trailing slash.
# VITE_SOCKET_URL=https://teamflow-ai-api.onrender.com
