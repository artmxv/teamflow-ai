# TeamFlow API — copy to server/.env and adjust for your environment.
# Do not commit server/.env (it is listed in .gitignore).
#
# Required: DATABASE_URL, JWT_SECRET
# Optional with defaults: PORT, NODE_ENV, CORS_ORIGIN (validated in server/src/config/env.ts)
# Prisma reads DATABASE_URL from the environment (not listed in env.ts).
#
# File uploads are stored on disk under server/uploads/ (gitignored).
# On many hosts the filesystem is ephemeral unless you mount persistent storage there.
# Downloads are served only via authenticated API routes (no public static folder).

# HTTP server
PORT=4000
NODE_ENV=development

# Browser origins allowed by CORS (must include your frontend URL; comma-separated for multiple dev ports)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# PostgreSQL connection for Prisma (default matches docker-compose.yml in this folder)
DATABASE_URL="postgresql://teamflow:teamflow@localhost:5433/teamflow_ai?schema=public"

# Secret for signing JWTs — use a long random value in production (never use the example below)
JWT_SECRET=change-me-in-production

# Email (workspace invitations)
# EMAIL_PROVIDER=console logs invite details to the server console (default)
# EMAIL_PROVIDER=resend sends via Resend when RESEND_API_KEY is set
EMAIL_PROVIDER=console
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM="TeamFlow AI <noreply@example.com>"

# Frontend URL for invitation accept links (must match the port you open in the browser)
APP_URL=http://localhost:5173
