# TeamFlow API — copy to server/.env and adjust for your environment.
# Do not commit server/.env (it is listed in .gitignore).
#
# Required: DATABASE_URL, JWT_SECRET
# Validated at startup in server/src/config/env.ts (see docs/DEPLOYMENT.md).
#
# File uploads
# FILE_STORAGE_DRIVER=local stores avatars on disk under server/uploads/ (gitignored).
# FILE_STORAGE_DRIVER=supabase uploads avatars to Supabase Storage (recommended for Render/production).
# Project documents and task attachments always use Supabase Storage when the variables below are set.
FILE_STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=teamflow-uploads

# HTTP server
PORT=4000
NODE_ENV=development

# Browser origins allowed by CORS (comma-separated for multiple origins).
# Production: must match the deployed frontend URL exactly (no trailing slash, not localhost).
# Example: CORS_ORIGIN=https://teamflow-ai-web.onrender.com
# Local dev (Vite + alternate port): http://localhost:5173,http://localhost:8080
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# PostgreSQL connection for Prisma (default matches docker-compose.yml in this folder)
DATABASE_URL="postgresql://teamflow:teamflow@localhost:5433/teamflow_ai?schema=public"

# Secret for signing JWTs.
# Production: must be a long random value — do not use the dev default below.
JWT_SECRET=dev-jwt-secret-change-in-production

# Email (workspace invitations)
# EMAIL_PROVIDER=console logs invite details to the server console (default).
# EMAIL_PROVIDER=resend sends via Resend — requires RESEND_API_KEY and a verified EMAIL_FROM.
# Production: EMAIL_FROM must use a verified sender/domain in Resend (not noreply@example.com).
EMAIL_PROVIDER=console
EMAIL_FROM="TeamFlow AI <noreply@example.com>"
RESEND_API_KEY=

# Public frontend URL for invitation accept links and OAuth redirects.
# Production: must be the deployed frontend URL (not localhost).
APP_URL=http://localhost:5173

# Google OAuth (optional — leave all three empty to disable Google sign-in)
# Production: if any Google variable is set, all three must be set.
# Production GOOGLE_REDIRECT_URI must be the deployed backend callback URL.
# If the client secret was exposed during dev, rotate/recreate it before production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Task deadline reminders (cron / Render scheduled job)
# Protects POST /api/internal/task-reminders/run — send as Authorization: Bearer <secret>
# Local example:
#   curl -X POST http://localhost:4000/api/internal/task-reminders/run \
#     -H "Authorization: Bearer local-dev-cron-secret"
TASK_REMINDER_CRON_SECRET=

# YooKassa test payments (one-time plan activation, no auto-renewal in V1).
# Team = 990 RUB, Business = 2490 RUB (source of truth is server PLAN_CONFIG).
# Webhook endpoint: POST /api/billing/webhook
# Events: payment.succeeded, payment.canceled
# Security: webhook body is not trusted; server re-fetches Payment via API (Basic Auth).
# YOOKASSA_RETURN_URL defaults to APP_URL/app/billing when empty.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
